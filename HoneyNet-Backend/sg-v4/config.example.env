# Copy to config.env and fill in the token, then run bootstrap.sh.
#   cp config.example.env config.env
#   nano config.env          # set AGENT_TOKEN (sent to you separately)
#   chmod 600 config.env

# Public URL of the backend (AWS App Runner).
BACKEND_URL=https://uddiejez3g.us-east-1.awsapprunner.com

# Bearer token the agent sends to the backend. MUST equal the backend's
# AGENT_TOKEN env var in App Runner. (Sent to you out-of-band — do not commit.)
AGENT_TOKEN=CHANGE_ME

# How often the agent reconciles containers to the backend target, in seconds.
POLL_SECONDS=15

# Honeypot compose file, relative to this folder (the agent runs from here).
COMPOSE_FILE=docker-compose/sentinelgrid-honeypots.yml
