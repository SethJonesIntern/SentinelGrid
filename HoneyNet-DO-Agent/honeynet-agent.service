[Unit]
Description=HoneyNet DO Agent (reconciles honeypot containers to backend target)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# The agent runs from the sentinelgrid root so its relative COMPOSE_FILE
# (docker-compose/sentinelgrid-honeypots.yml) and the forwarder's ./forwarder
# mount resolve. Deploy agent.py + config.env into /opt/sentinelgrid alongside
# the docker-compose/ directory.
WorkingDirectory=/opt/sentinelgrid
EnvironmentFile=/opt/sentinelgrid/config.env
ExecStart=/usr/bin/python3 /opt/sentinelgrid/agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
