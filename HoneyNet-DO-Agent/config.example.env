# Copy to config.env on the Droplet and fill in. Load with: `set -a; . ./config.env; set +a`
# (or use the systemd unit, which reads this file via EnvironmentFile).

# Public URL of the backend (AWS App Runner).
BACKEND_URL=https://xxxxxxxx.us-east-1.awsapprunner.com

# Bearer token the agent sends to the backend. Must match the backend's
# AGENT_TOKEN env (set it in the App Runner service config too).
AGENT_TOKEN=change-me-shared-secret

# How often to reconcile, in seconds.
POLL_SECONDS=15

# Path to the honeypot compose file (relative to the agent's working dir, which
# should be the sentinelgrid/ root so the relative build contexts resolve).
COMPOSE_FILE=docker-compose/sentinelgrid-honeypots.yml
